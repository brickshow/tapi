{
  "expo": {
    "name": "tigom",
    "slug": "tigom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tigom-icon.png",
    "scheme": [
      "tigom",
      "tapi"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/tigom-icon.png",
      "infoPlist": {
        "CFBundleDisplayName": "tigom."
      }
    },
    "android": {
      "package": "com.studiolaunchweb.tigom",
      "adaptiveIcon": {
        "backgroundColor": "#F4F1E8",
        "foregroundImage": "./assets/images/tigom-foreground.png",
        "monochromeImage": "./assets/images/tigom-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "./plugins/with-tigom-display-name",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TigomQuickSave",
              "label": "tigom. Quick Save",
              "minWidth": "250dp",
              "minHeight": "120dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "description": "Tap a coin value to add it to your tigom. savings."
            }
          ]
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow tigom to use Face ID to protect your savings."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "gifEnabled": false,
            "webpEnabled": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a44c4cbf-3a08-4f3e-adb9-90665150a426"
      }
    },
    "owner": "studiolaunchweb"
  }
}
